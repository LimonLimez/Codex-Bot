                    disabled: !zR,
                    title: zR
                      ? "Allow this action once"
                      : "Waiting for the exact approval screen to load",
                    onClick: () => zR && R("allow-once"),
                    children: "Allow once",
                  }),
                  q.siteLeaseAvailable
                    ? h.jsx("button", {
                        type: "button",
                        onClick: () => R("allow-site"),
                        children: "Allow this site briefly",
                      })
                    : null,
                  h.jsx("button", {
                    type: "button",
                    onClick: () => R("deny"),
                    children: "Deny",
                  }),
                ],
              }),
            ],
          })
        : null,
    ],
  });
}
